# Copy this file to cicd-demo/.env (gitignored, never committed/pushed) and
# fill in real values. Once this file exists, every demo script picks it up
# automatically -- no need to export anything by hand.

# Owner-role LiveReview API key for the org this demo runs against
# (Settings -> API Keys in the LiveReview web UI).
LIVEREVIEW_API_KEY=

# That org's id.
LIVEREVIEW_ORG_ID=

# The "Block on Critical or Security" ruleset's id (LiveReview -> CI/CD Gates
# page, or the id create_ruleset.sh printed when it was set up).
LIVEREVIEW_RULESET_ID=
